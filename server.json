{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dreamworkhq/dreamwork",
  "title": "Dreamwork",
  "description": "Job search, application materials, and application tracking for AI assistants.",
  "repository": {
    "url": "https://github.com/dreamworkhq/mcp",
    "source": "github",
    "subfolder": "apps/mcp"
  },
  "version": "1.5.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@dreamworkhq/mcp",
      "version": "1.5.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DREAMWORK_API_KEY",
          "description": "Dreamwork API key (sk_...) for account tools; public job browsing works without a key",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "DREAMWORK_API_URL",
          "description": "API endpoint override (default: https://api.dreamworkhq.com)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.dreamworkhq.com/mcp"
    }
  ]
}
